# 国家地理每日精选 · 钉钉机器人配置
# 复制为 .env（已被 .gitignore 忽略）并填入真实值；也可由调度环境直接注入同名变量。
# 建议在钉钉群机器人设置里改用「加签」安全设置，并把 secret 填到 NATGEO_DINGTALK_SECRET。

# 群机器人 Webhook 完整地址（含 access_token）
NATGEO_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here

# 加签密钥（机器人安全设置为「加签」时填写，留空则不加签）
NATGEO_DINGTALK_SECRET=

# DeepSeek 翻译（可选；Hermes 会话内运行时无 key 会跳过脚本内翻译）
DEEPSEEK_API_KEY=
