# csi300-brief 钉钉推送配置
#
# 复制为 .env 后填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 的 **/.env 排除，不会进入 git 历史。
#
# DINGTALK_WEBHOOK：群机器人 Webhook 完整地址（含 access_token）
# DINGTALK_KEYWORD：机器人安全设置里的自定义关键词；消息标题/正文必须包含它，否则返回 310000
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_ACCESS_TOKEN_HERE
DINGTALK_KEYWORD=ETF
