    {
      "anchor": "## 核心结论",
      "statements": [
        {
          "template": "本期营业收入 {rev:amount_yi}，同比变化 {rev_yoy:percent2}。",
          "bindings": {
            "rev": {"fact_id": "FACT_REVENUE_CUR"},
            "rev_yoy": {"metric_id": "revenue_yoy"}
          },
          "claim_type": "calculation"
        },
        {
          "template": "合并净利润 {np:amount_wan}，其中归属于母公司股东的净利润 {npo:amount_wan}。",
          "bindings": {
            "np": {"fact_id": "FACT_NET_PROFIT_GROUP_CUR"},
            "npo": {"fact_id": "FACT_NET_PROFIT_OWNERS_CUR"}
          },
          "claim_type": "fact"
        },
        {
          "template": "经营活动产生的现金流量净额 {cfo:amount_wan}，简化自由现金流 {fcf:amount_wan}。",
          "bindings": {
            "cfo": {"fact_id": "FACT_CFO_CUR"},
            "fcf": {"metric_id": "simplified_fcf"}
          },
          "claim_type": "calculation"
        },
        {
          "template": "期末资产总计 {ta:amount_yi}，负债合计 {tl:amount_yi}，所有者权益合计 {te:amount_yi}。",
          "bindings": {
            "ta": {"fact_id": "FACT_TOTAL_ASSETS_CUR"},
            "tl": {"fact_id": "FACT_TOTAL_LIABILITIES_CUR"},
