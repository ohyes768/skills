# finance-macro 宏观采集 Skill 环境变量
#
# 复制为 finance-macro/.env 并填入真实值（.env 已被 .gitignore 排除，不会入库）。
# 所有 skill 的脚本按以下优先级读取：
#   1. 进程环境变量（已设则不覆盖）
#   2. finance-macro/.env        ← 首选
#   3. <skill-name>/.env         ← 回退

# ── 线上 macro 后端推送 ────────────────────────────────────────────────
# 上传 token 与 API 地址（web.duomi77.cn:9443 的 macro 信号接口）
MACRO_SIGNAL_UPLOAD_TOKEN=
MACRO_SIGNAL_UPLOAD_URL=https://web.duomi77.cn:9443/api/macro/signal/upload
# 自签证书场景设为 0 跳过校验
MACRO_UPLOAD_SSL_VERIFY=0

# ── Tavily 搜索（核心 CPI / 社融 / MLF 抓取）────────────────────────
# 缺失时对应指标 parse_status=failed，signal 里该维度为 null
TAVILY_API_KEY=

# ── DeepSeek 抽取（Tavily 结果 → 结构化字段）──────────────────────────
# 缺失时对应指标 parse_status=failed，signal 里该维度为 null
DEEPSEEK_API_KEY=
